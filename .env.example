# ==============================================================================
# 🌍 PUBLIC & SERVER CONFIG (SAFE FOR CLOUD RUN ENV VARS BULK PASTE)
# ==============================================================================

# 1. Active Brand Identifier
NEXT_PUBLIC_BRAND="brand-name"
NEXT_PUBLIC_ENABLE_CART="false"
NEXT_PUBLIC_SUPPORTED_LOCALES="en,fr"
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# 2. Application Base URL
NEXT_PUBLIC_APP_URL="https://..."

# 3. Google Tag Manager
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# 4. Auth.js Configuration
AUTH_URL="https://..."
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID="your-client-id.apps.googleusercontent.com"
ADMIN_EMAILS="email1@gmail.com,email2@gmail.com"

# 5. Firebase Client Configuration
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_API_KEY="AIza..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abcde"
NEXT_PUBLIC_FIREBASE_DATABASE_ID="(default)"

# 6. Firebase Admin Configuration (Server-side)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_DATABASE_ID="(default)"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com"

# 7. Google Places
GOOGLE_PLACES_API_KEY="AIza..."

# 8. Stripe Public Configuration (Only when NEXT_PUBLIC_ENABLE_CART="true")
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ==============================================================================
# 🔒 SECRETS (DO NOT BULK PASTE! USE GCP SECRET MANAGER)
# ==============================================================================

AUTH_SECRET="your-auth-secret"
AUTH_GOOGLE_SECRET="your-google-secret"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
REVALIDATION_SECRET="your-revalidation-secret"

