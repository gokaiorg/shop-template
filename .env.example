# ==============================================================================
# 🌍 PUBLIC & SERVER CONFIG (SAFE FOR CLOUD RUN ENV VARS BULK PASTE)
# ==============================================================================

# 1. Active Brand Identifier
NEXT_PUBLIC_BRAND="nom-de-la-marque"
NEXT_PUBLIC_ENABLE_CART="false"
NEXT_PUBLIC_SUPPORTED_LOCALES="en,fr"
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# 2. Application Base URL
NEXT_PUBLIC_APP_URL="https://..."

# 3. Google Tag Manager
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# 4. Auth.js Configuration
AUTH_URL="https://..."
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID="ton-client-id.apps.googleusercontent.com"
ADMIN_EMAILS="email1@gmail.com,email2@gmail.com"

# 5. Firebase Client Configuration
NEXT_PUBLIC_FIREBASE_PROJECT_ID="ton-project-id"
NEXT_PUBLIC_FIREBASE_API_KEY="AIza..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="ton-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="ton-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abcde"
NEXT_PUBLIC_FIREBASE_DATABASE_ID="nom-de-la-base"

# 6. Firebase Admin Configuration (Server-side)
FIREBASE_PROJECT_ID="ton-project-id"
FIREBASE_DATABASE_ID="nom-de-la-base"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@ton-project.iam.gserviceaccount.com"

# 7. Stripe Public Configuration (Laisser vide ou placeholder si le panier est désactivé)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ==============================================================================
# 🔒 SECRETS (DO NOT BULK PASTE! USE GCP SECRET MANAGER)
