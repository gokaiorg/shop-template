{
  "firestore": [
    {
      "database": "shop-template-database",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    },
    {
      "database": "(default)",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "hosting": [
    {
      "target": "gokai-labs",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "gokai-labs-main",
            "region": "europe-west1"
          }
        }
      ]
    },
    {
      "target": "art-fate",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "art-fate-main",
            "region": "europe-west1"
          }
        }
      ]
    }
  ]
}
